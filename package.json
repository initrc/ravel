{
  "name": "@initrc/ravel",
  "version": "2.0.2",
  "description": "Orchestrator for interactive AI coding",
  "type": "module",
  "bin": {
    "ravel": "bin/ravel.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf bin && tsc --noEmit && tsc --project tsconfig.build.json && mkdir -p bin && cp -r templates bin/",
    "prepublishOnly": "npm run build",
    "start": "node bin/ravel.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "clipboardy": "^5.3.1",
    "gray-matter": "^4.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
